# setup_postfix.sh configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Values here are auto-loaded by setup_postfix.sh.
# CLI flags (--smtp-host, etc.) override these.

# SMTP relay hostname
SMTP_HOST=smtp.gmail.com

# SMTP relay port (587 for TLS/STARTTLS)
SMTP_PORT=587

# Your email address / SMTP login
SMTP_USER=yourname@gmail.com

# App password (NOT your regular password)
# Gmail: https://myaccount.google.com/apppasswords
# iCloud: https://appleid.apple.com → App-Specific Passwords
SMTP_PASS=abcd efgh ijkl mnop

# Address for test emails and -notify alerts
# Format: 10-digit-phone-number@carrier-gateway for SMS message
# T-Mobile:  5551234567@tmomail.net
# Verizon:   5551234567@vtext.com
# AT&T:      5551234567@txt.att.net
TEST_ADDR=5551234567@tmomail.net
